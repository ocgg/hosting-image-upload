<div id="<%= dom_id article %>">
  <% if article.photo.attached? %>
    <%= cl_image_tag article.photo.key, height: 300, width: 400, crop: :fill %>
  <% end %>
  
  <div>
    <strong>Title:</strong>
    <%= article.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= article.body %>
  </div>

</div>
